<?xml version='1.0' encoding='utf-8'?>
<widget id="com.gutylog.shadowsystem" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Shadow System RPG</name>
    <description>Sistema RPG de Evolución Personal y Misiones Diarias</description>
    <author email="contacto@gutylog.com" href="https://github.com/">
        GUTY-LOG Desarrollo Digital
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Bloquear pantalla en modo vertical y pantalla completa -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xff060913" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- Blindaje de Memoria Interna en Android -->
    <preference name="AndroidPersistentFileLocation" value="Internal" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <allow-intent href="market:*" />
    </platform>
</widget>
